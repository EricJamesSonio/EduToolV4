# Backend API base URL — MUST be the public backend URL in production.
# (Baked into the bundle at build time; localhost is only for local dev.)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Socket.io server URL (usually same as API)
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Agora App ID (get from console.agora.io)
NEXT_PUBLIC_AGORA_APP_ID=
NEXT_PUBLIC_WS_URL=http://localhost:5000
