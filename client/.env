# EduTool Environment Variables
# Copy this file to your project root as .env.local
# Never commit this file to version control
# Note: For Vite, environment variables must be prefixed with VITE_

# Backend API base URL
VITE_PUBLIC_API_URL=http://localhost:5000

# Socket.io server URL (usually same as API)
VITE_PUBLIC_SOCKET_URL=http://localhost:5000

# Agora App ID (get from console.agora.io)
VITE_PUBLIC_AGORA_APP_ID=your_agora_app_id_here
