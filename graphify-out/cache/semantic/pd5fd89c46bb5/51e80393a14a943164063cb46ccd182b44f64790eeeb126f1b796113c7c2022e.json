{"nodes": [{"id": "_build_adminrequest_overview_overview_doc", "label": "Admin Account Request Overview", "file_type": "document", "source_file": ".Build/AdminRequest/overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_build_adminrequest_overview_adminaccountrequest", "label": "Admin Account Request Feature", "file_type": "concept", "source_file": ".Build/AdminRequest/overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Upgrade of the existing registration-request flow (Otp, RegistrationRequest, platform-registration module, AuthService.register/verifyOtp, AuthRepository.createAccount), not a new parallel system; reusing existing logic and avoiding duplication is the stated failure mode."}, {"id": "_build_adminrequest_overview_gmaillookup", "label": "Personal-Gmail Lookup Key", "file_type": "rationale", "source_file": ".Build/AdminRequest/overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Personal Gmail is the sole lookup key (unlike the Enrollment Portal's 4-char code). Gmail guarantees local-part uniqueness globally, which transfers to the generated login address so no collision-disambiguator is needed. Strictly @gmail.com only, retrofitted onto the Enrollment Portal's personal_email field."}, {"id": "_build_adminrequest_overview_loginemailpolicy", "label": "System-Generated Login Email Policy", "file_type": "rationale", "source_file": ".Build/AdminRequest/overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Login email is system-generated and decoupled from the personal Gmail: {gmailLocalPart}@admin.relief-ed, domain treated as a named constant. Personal Gmail is notification-only, mirroring the relationship Profile.personal_email already has for students."}, {"id": "_build_adminrequest_overview_perfieldrevision", "label": "Per-Field Revision Flagging", "file_type": "rationale", "source_file": ".Build/AdminRequest/overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Platform owner flags individual fields (e.g. institution_name with a short note). On resubmission all flags clear and status returns to pending for full re-review - same auto-reopen convention used in the Concern Center feature."}, {"id": "_build_adminrequest_overview_2hr_session", "label": "Two-Hour Application Session", "file_type": "concept", "source_file": ".Build/AdminRequest/overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Time-limited session instead of one-shot submission, matching the Enrollment Portal UX standard; explicit decision to reuse the existing enrollment-session.guard.ts / enrollment-session.decorator.ts mechanism rather than rebuild it."}, {"id": "_build_adminrequest_overview_three_outcomes", "label": "Three Review Outcomes", "file_type": "concept", "source_file": ".Build/AdminRequest/overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three outcomes on review: approve (creates account, emails credentials), reject (emails a rejection notice), request-revision (emails a notice + flags specific fields; applicant sees ! markers on next Gmail-lookup access)."}], "edges": [{"source": "_build_adminrequest_overview_overview_doc", "target": "_build_adminrequest_overview_adminaccountrequest", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".Build/AdminRequest/overview.md", "source_location": null, "weight": 1.0}, {"source": "_build_adminrequest_overview_overview_doc", "target": "_build_adminrequest_overview_gmaillookup", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".Build/AdminRequest/overview.md", "source_location": null, "weight": 1.0}, {"source": "_build_adminrequest_overview_overview_doc", "target": "_build_adminrequest_overview_loginemailpolicy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".Build/AdminRequest/overview.md", "source_location": null, "weight": 1.0}, {"source": "_build_adminrequest_overview_overview_doc", "target": "_build_adminrequest_overview_perfieldrevision", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".Build/AdminRequest/overview.md", "source_location": null, "weight": 1.0}, {"source": "_build_adminrequest_overview_overview_doc", "target": "_build_adminrequest_overview_2hr_session", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".Build/AdminRequest/overview.md", "source_location": null, "weight": 1.0}, {"source": "_build_adminrequest_overview_overview_doc", "target": "_build_adminrequest_overview_three_outcomes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".Build/AdminRequest/overview.md", "source_location": null, "weight": 1.0}, {"source": "_build_adminrequest_overview_overview_doc", "target": "_build_adminrequest_phase1_phase1_doc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".Build/AdminRequest/overview.md", "source_location": null, "weight": 1.0}, {"source": "_build_adminrequest_overview_overview_doc", "target": "_build_enrollment_overview_enrollmentportal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".Build/AdminRequest/overview.md", "source_location": null, "weight": 1.0}, {"source": "_build_adminrequest_overview_perfieldrevision", "target": "_build_concerncenter_overview_autoreopen", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.