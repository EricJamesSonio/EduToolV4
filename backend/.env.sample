# App Environment
NODE_ENV=production
PORT=5000
APP_NAME=EduTool

# CORS — comma-separated list of allowed frontend origins.
# Required for the deployed frontend to reach the API.
CORS_ORIGIN=https://your-frontend.onrender.com

# Express `trust proxy` (optional). Controls how the client IP used for HTTP
# rate limiting (ThrottlerGuard buckets on req.ip) is derived.
# When unset: 1 in production, false elsewhere.
# Accepted values:
#   - non-negative integer  -> hop count, e.g. 1
#   - "true" / "false"      -> trust (or ignore) all proxies
#   - anything else         -> comma-separated IP/subnet list,
#                              e.g. "10.0.0.1,192.168.0.0/16"
#
# The hop count MUST match your real proxy chain:
#   - TOO LOW  -> req.ip stays the proxy's IP, so EVERY user shares one rate
#                 limit bucket. Symptom: login throttling locks everyone out
#                 together, even from different networks.
#   - TOO HIGH -> req.ip is read from a client-controllable position in
#                 X-Forwarded-For, so a client can spoof it and evade limits.
#                 Symptom: req.ip equals a value you set in your own request.
#
# To verify after deploy, set TRUST_PROXY_DEBUG=true and send one request:
#   curl -H "X-Forwarded-For: 203.0.113.9" https://<your-api>/health
# then check the logs for the `[trust-proxy]` line. It should show a
# private/proxy address matching the LAST X-Forwarded-For entry, NOT the
# 203.0.113.9 you sent. Turn the flag back off afterwards.
#TRUST_PROXY=1
#TRUST_PROXY_DEBUG=false

# Database
DATABASE_URL="postgresql://<username>:<password>@<host>:<port>/<database>"

# Set to "false" when using a managed Postgres (Aiven/Supabase/Neon) whose TLS
# chain is self-signed or unknown to the runtime.
DB_SSL_REJECT_UNAUTHORIZED=false

# Auth — REQUIRED. No fallback value is used.
JWT_SECRET=<your_jwt_secret>
JWT_EXPIRES_IN=1d

# AI / OpenRouter
OPENROUTER_API_KEY=<your_openrouter_api_key>
AI_MODEL=openrouter/free
APP_URL=https://your-frontend.onrender.com

# Agora (Video/RTC)
AGORA_APP_ID=<your_agora_app_id>
AGORA_APP_CERT=<your_agora_app_certificate>

# Giphy (Groupy GIF search proxy) — keeps the key server-side only.
GIPHY_API_KEY=<your_giphy_api_key>

# Email (optional) — if unset the app still boots; OTP/credentials emails fail
# at send time with a logged error.
GMAIL_EMAIL=<your_gmail_address>
GMAIL_APP_PASSWORD=<your_gmail_app_password>