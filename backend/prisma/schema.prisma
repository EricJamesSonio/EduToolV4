datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

//////////////////////
// ENUMS
//////////////////////

enum Role {
  platform_owner
  admin
  educator
  student
}

enum AccountStatus {
  active
  suspended
  pending
  dropped
  transferred
  graduated
}

enum EnrollmentStatus {
  active
  pending
  removed
}

enum SubmissionStatus {
  draft
  submitted
  exempted
  custom
}

enum AttendanceStatus {
  present
  absent
  late
  excused
}

enum SchoolYearStatus {
  pending
  active
  ended
}

enum SchoolYearEnrollmentStatus {
  active
  pending
  unenrolled
}

enum GradingMode {
  system
  manual
  hybrid
}

//////////////////////
// CORE TABLES
//////////////////////

model Organization {
  id          String  @id @default(uuid())
  name        String
  description String?
  address     String?
  logo_url    String?

  email_extension String? @unique

  admin_account_id String? @unique

  accounts Account[]
}

model OrgEnrollmentSetting {
  id                            String   @id @default(uuid())
  org_id                        String   @unique
  require_semester_reenrollment Boolean  @default(false)
  auto_unenroll_on_year_end     Boolean  @default(true)
  created_at                    DateTime @default(now())
  updated_at                    DateTime @updatedAt
}

model Account {
  id         String        @id @default(uuid())
  org_id     String?
  role       Role
  email      String        @unique
  password   String
  status     AccountStatus
  created_at DateTime      @default(now())
  updated_at DateTime      @updatedAt
  deleted_at DateTime?

  organization Organization? @relation(fields: [org_id], references: [id])
  profile      Profile?

  classes Class[] @relation("EducatorClasses")

  @@unique([org_id, email])
}

model Profile {
  id             String   @id @default(uuid())
  account_id     String   @unique
  full_name      String
  metadata       Json?
  personal_email String?
  profile_image  String?  @default("profile/default.png")
  created_at     DateTime @default(now())

  account Account @relation(fields: [account_id], references: [id])
}

//////////////////////
// STRUCTURE
//////////////////////

model Program {
  id             String @id @default(uuid())
  org_id         String
  school_year_id String
  name           String
  type           String

  schoolYear         SchoolYear                 @relation(fields: [school_year_id], references: [id])
  courses            Course[]
  strands            Strand[]
  levels             Level[]
  subjects           Subject[]
  studentEnrollments StudentProgramEnrollment[]
  semesterAssignment      ProgramSemesterAssignment?
  gradingScaleAssignments GradingScaleAssignment[]
  programCalendars        ProgramCalendar[]
}

model Course {
  id             String  @id @default(uuid())
  org_id         String
  school_year_id String
  program_id     String
  name           String
  code           String?

  schoolYear         SchoolYear                 @relation(fields: [school_year_id], references: [id])
  program            Program                    @relation(fields: [program_id], references: [id])
  subjects           Subject[]
  sharings           SubjectSharing[]
  studentEnrollments StudentProgramEnrollment[]
  sections           Section[]
  levels             Level[]
}

model Strand {
  id             String @id @default(uuid())
  org_id         String
  school_year_id String
  program_id     String
  name           String

  schoolYear         SchoolYear                 @relation(fields: [school_year_id], references: [id])
  program            Program                    @relation(fields: [program_id], references: [id])
  subjects           Subject[]
  sharings           SubjectSharing[]
  studentEnrollments StudentProgramEnrollment[]
  sections           Section[]
  levels             Level[]
}

model Level {
  id             String  @id @default(uuid())
  org_id         String
  school_year_id String
  program_id     String
  course_id      String?
  strand_id      String?
  name           String

  schoolYear         SchoolYear                 @relation(fields: [school_year_id], references: [id])
  program            Program                    @relation(fields: [program_id], references: [id])
  course             Course?                    @relation(fields: [course_id], references: [id])
  strand             Strand?                    @relation(fields: [strand_id], references: [id])
  sections           Section[]
  sharings           SubjectSharing[]
  studentEnrollments StudentProgramEnrollment[]
  subjects           Subject[]
}

model Section {
  id             String    @id @default(uuid())
  org_id         String
  level_id       String
  course_id      String?
  strand_id      String?
  school_year_id String
  name           String
  capacity       Int
  deleted_at     DateTime?

  level              Level                      @relation(fields: [level_id], references: [id])
  course             Course?                    @relation(fields: [course_id], references: [id])
  strand             Strand?                    @relation(fields: [strand_id], references: [id])
  schoolYear         SchoolYear                 @relation(fields: [school_year_id], references: [id])
  studentEnrollments StudentProgramEnrollment[]
}

model SchoolYear {
  id         String           @id @default(uuid())
  org_id     String
  name       String
  status     SchoolYearStatus @default(pending)
  start_date DateTime?
  end_date   DateTime?

  programs           Program[]
  courses            Course[]
  strands            Strand[]
  levels             Level[]
  sections           Section[]
  gradingScaleAssignments GradingScaleAssignment[]
  studentEnrollments      StudentSchoolYear[]
  semesters          Semester[]
  classes            Class[]
  academicCalendars  AcademicCalendar[]
  programCalendars   ProgramCalendar[]
}

model SemesterTemplate {
  id           String @id @default(uuid())
  org_id       String
  program_type String
  name         String

  semesters   SemesterTemplateItem[]
  assignments ProgramSemesterAssignment[]
}

model SemesterTemplateItem {
  id          String @id @default(uuid())
  org_id      String
  template_id String
  name        String
  order_index Int

  template SemesterTemplate       @relation(fields: [template_id], references: [id])
  terms    SemesterTemplateTerm[]
}

model SemesterTemplateTerm {
  id          String @id @default(uuid())
  org_id      String
  semester_id String
  name        String
  order_index Int

  semester  SemesterTemplateItem      @relation(fields: [semester_id], references: [id], onDelete: Cascade)
  termDates ProgramSemesterTermDate[]
}

model ProgramSemesterAssignment {
  id          String @id @default(uuid())
  org_id      String
  program_id  String @unique
  template_id String

  program   Program                   @relation(fields: [program_id], references: [id])
  template  SemesterTemplate          @relation(fields: [template_id], references: [id])
  termDates ProgramSemesterTermDate[]
}

model ProgramSemesterTermDate {
  id            String   @id @default(uuid())
  org_id        String
  assignment_id String
  term_id       String
  start_date    DateTime
  end_date      DateTime

  assignment ProgramSemesterAssignment @relation(fields: [assignment_id], references: [id])
  term       SemesterTemplateTerm      @relation(fields: [term_id], references: [id], onDelete: Cascade)

  @@unique([assignment_id, term_id])
}

model StudentSchoolYear {
  id             String                     @id @default(uuid())
  org_id         String
  student_id     String
  school_year_id String
  status         SchoolYearEnrollmentStatus @default(pending)
  enrolled_at    DateTime                   @default(now())
  unenrolled_at  DateTime?
  notes          String?

  schoolYear         SchoolYear                 @relation(fields: [school_year_id], references: [id])
  programEnrollments StudentProgramEnrollment[]

  @@unique([org_id, student_id, school_year_id])
}

model StudentProgramEnrollment {
  id                     String           @id @default(uuid())
  org_id                 String
  student_school_year_id String
  program_id             String
  level_id               String?
  course_id              String?
  strand_id              String?
  section_id             String?
  status                 EnrollmentStatus @default(active)
  enrolled_at            DateTime         @default(now())

  studentSchoolYear StudentSchoolYear @relation(fields: [student_school_year_id], references: [id])
  program           Program           @relation(fields: [program_id], references: [id])
  level             Level?            @relation(fields: [level_id], references: [id])
  course            Course?           @relation(fields: [course_id], references: [id])
  strand            Strand?           @relation(fields: [strand_id], references: [id])
  section           Section?          @relation(fields: [section_id], references: [id])

  @@unique([student_school_year_id, program_id])
}

model Semester {
  id             String   @id @default(uuid())
  org_id         String
  school_year_id String
  name           String
  start_date     DateTime
  end_date       DateTime

  schoolYear SchoolYear @relation(fields: [school_year_id], references: [id])
  terms      Term[]
}

model Term {
  id          String   @id @default(uuid())
  org_id      String
  semester_id String
  name        String
  order_index Int
  start_date  DateTime
  end_date    DateTime

  semester Semester @relation(fields: [semester_id], references: [id])
}

//////////////////////
// ACADEMIC
//////////////////////

model Subject {
  id           String  @id @default(uuid())
  org_id       String
  name         String
  subject_type String  @default("major")
  program_id   String?
  level_id     String?
  course_id    String?
  strand_id    String?
  educator_id  String?
  is_locked    Boolean @default(false)
  year_level   String?
  term_label   String?

  program Program? @relation(fields: [program_id], references: [id])
  course  Course?  @relation(fields: [course_id], references: [id])
  strand  Strand?  @relation(fields: [strand_id], references: [id])
  level   Level?   @relation(fields: [level_id], references: [id])
  classes Class[]

  prerequisites SubjectPrerequisite[] @relation("SubjectPrereqs")
  prereqFor     SubjectPrerequisite[] @relation("PrereqFor")
  sharings      SubjectSharing[]
}

model SubjectSharing {
  id         String  @id @default(uuid())
  org_id     String
  subject_id String
  course_id  String?
  strand_id  String?
  level_id   String?

  subject Subject @relation(fields: [subject_id], references: [id])
  course  Course? @relation(fields: [course_id], references: [id])
  strand  Strand? @relation(fields: [strand_id], references: [id])
  level   Level?  @relation(fields: [level_id], references: [id])

  @@unique([subject_id, course_id])
  @@unique([subject_id, strand_id])
  @@unique([subject_id, level_id])
}

model SubjectPrerequisite {
  id              String @id @default(uuid())
  org_id          String
  subject_id      String
  prerequisite_id String

  subject      Subject @relation("SubjectPrereqs", fields: [subject_id], references: [id])
  prerequisite Subject @relation("PrereqFor", fields: [prerequisite_id], references: [id])

  @@unique([subject_id, prerequisite_id])
}

model Class {
  id             String    @id @default(uuid())
  org_id         String
  subject_id     String
  educator_id    String
  section_id     String?
  school_year_id String
  semester_id    String
  capacity       Int
  created_at     DateTime  @default(now())
  deleted_at     DateTime?

  subject         Subject             @relation(fields: [subject_id], references: [id])
  educator        Account             @relation("EducatorClasses", fields: [educator_id], references: [id])
  schoolYear      SchoolYear          @relation(fields: [school_year_id], references: [id])
  schedules       ClassSchedule[]
  enrollments     Enrollment[]
  gradeLock       GradeLock?
  ownershipLogs   ClassOwnershipLog[]
  meetings        Meeting[]
  grades          Grade[]
  gradingSchemes  GradingScheme[]
  gradeLockEvents GradeLockEvent[]
}

model ClassSchedule {
  id         String   @id @default(uuid())
  org_id     String
  class_id   String
  weekday    Int
  start_time DateTime
  end_time   DateTime

  class Class @relation(fields: [class_id], references: [id])
}

model ClassOwnershipLog {
  id               String   @id @default(uuid())
  org_id           String
  class_id         String
  from_educator_id String
  to_educator_id   String
  reason           String?
  reassigned_at    DateTime @default(now())
  reassigned_by    String

  class Class @relation(fields: [class_id], references: [id])
}

model Enrollment {
  id         String           @id @default(uuid())
  org_id     String
  class_id   String
  student_id String
  status     EnrollmentStatus
  created_at DateTime         @default(now())

  class Class @relation(fields: [class_id], references: [id])
}

//////////////////////
// ACADEMIC CALENDAR
//////////////////////

model AcademicCalendar {
  id             String   @id @default(uuid())
  org_id         String
  school_year_id String
  title          String
  type           String
  start_date     DateTime
  end_date       DateTime
  description    String?
  created_at     DateTime @default(now())

  schoolYear SchoolYear @relation(fields: [school_year_id], references: [id])
}

//////////////////////
// PROGRAM ACADEMIC CALENDAR
//////////////////////

model ProgramCalendar {
  id             String   @id @default(uuid())
  org_id         String
  school_year_id String
  program_id     String
  start_date     DateTime
  end_date       DateTime
  notes          String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  schoolYear SchoolYear               @relation(fields: [school_year_id], references: [id], onDelete: Cascade)
  program    Program                  @relation(fields: [program_id], references: [id], onDelete: Cascade)
  breaks     ProgramCalendarBreak[]
  terms      ProgramCalendarTerm[]
  holidays   ProgramCalendarHoliday[]

  @@unique([program_id, school_year_id])
}

model ProgramCalendarBreak {
  id          String   @id @default(uuid())
  org_id      String
  calendar_id String
  label       String
  start_date  DateTime
  end_date    DateTime
  order_index Int
  created_at  DateTime @default(now())

  calendar ProgramCalendar @relation(fields: [calendar_id], references: [id], onDelete: Cascade)
}

model ProgramCalendarTerm {
  id          String   @id @default(uuid())
  org_id      String
  calendar_id String
  label       String
  order_index Int
  start_date  DateTime
  end_date    DateTime
  created_at  DateTime @default(now())

  calendar ProgramCalendar @relation(fields: [calendar_id], references: [id], onDelete: Cascade)
}

model ProgramCalendarHoliday {
  id          String   @id @default(uuid())
  org_id      String
  calendar_id String
  holiday_key String?
  title       String
  date        DateTime
  description String?
  type        String
  created_at  DateTime @default(now())

  calendar ProgramCalendar @relation(fields: [calendar_id], references: [id], onDelete: Cascade)
}

//////////////////////
// HOLIDAY CONFIG
//////////////////////

model OrgHolidayConfig {
  id              String   @id @default(uuid())
  org_id          String   @unique
  enabled_keys    String[]
  custom_holidays Json     @default("[]")
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
}

//////////////////////
// GRADING SCALE
//////////////////////

model GradingScale {
  id           String    @id @default(uuid())
  org_id       String
  name         String
  program_type String
  ranges       Json
  is_locked    Boolean   @default(false)
  locked_at    DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  assignments GradingScaleAssignment[]
}

model GradingScaleAssignment {
  id               String       @id @default(uuid())
  org_id           String
  grading_scale_id String
  program_id       String
  school_year_id   String
  created_at       DateTime     @default(now())

  grading_scale GradingScale @relation(fields: [grading_scale_id], references: [id], onDelete: Cascade)
  program       Program      @relation(fields: [program_id], references: [id])
  school_year   SchoolYear   @relation(fields: [school_year_id], references: [id])

  @@unique([program_id, school_year_id])
}

//////////////////////
// GRADING SCHEME TEMPLATES
//////////////////////

model GradingSchemeTemplate {
  id           String   @id @default(uuid())
  org_id       String
  name         String
  program_type String?
  created_at   DateTime @default(now())

  components GradingSchemeTemplateComponent[]
}

model GradingSchemeTemplateComponent {
  id          String   @id @default(uuid())
  org_id      String
  template_id String
  name        String
  type        String
  weight      Float
  max_score   Float?
  created_at  DateTime @default(now())

  template GradingSchemeTemplate @relation(fields: [template_id], references: [id])
}

//////////////////////
// GRADING SCHEME
//////////////////////

model GradingScheme {
  id          String    @id @default(uuid())
  org_id      String
  class_id    String
  template_id String?
  name        String
  is_locked   Boolean   @default(false)
  locked_at   DateTime?
  created_at  DateTime  @default(now())
  is_default  Boolean   @default(false)

  class      Class                    @relation(fields: [class_id], references: [id])
  components GradingSchemeComponent[]
}

model GradingSchemeComponent {
  id                String   @id @default(uuid())
  org_id            String
  grading_scheme_id String
  name              String
  type              String
  weight            Float
  max_score         Float?
  is_optional       Boolean  @default(false)
  created_at        DateTime @default(now())

  gradingScheme GradingScheme @relation(fields: [grading_scheme_id], references: [id])
}

//////////////////////
// LESSONS
//////////////////////

model Lesson {
  id          String   @id @default(uuid())
  org_id      String
  class_id    String
  title       String
  description String?
  detail      String?
  week_number Int
  sub_index   Int
  created_at  DateTime @default(now())

  concept LessonConcept?

  @@unique([class_id, week_number, sub_index])
}

model LessonConcept {
  id             String   @id @default(uuid())
  org_id         String
  lesson_id      String   @unique
  content        Json
  raw_response   String?
  raw_request    String?
  prompt_version String?
  created_at     DateTime @default(now())

  lesson Lesson @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
}

// ── PRESENTATIONS ──────────────────────────────────────────────────────────

model Presentation {
  id          String   @id @default(uuid())
  org_id      String
  class_id    String
  lesson_id   String
  title       String
  template    String   @default("modern")
  settings    Json     @default("{}")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  slides Slide[]

  @@map("presentations")
}

model Slide {
  id             String   @id @default(uuid())
  presentation_id String
  slide_number   Int
  title          String?
  content        String
  lesson_section String?
  created_at     DateTime @default(now())

  presentation Presentation @relation(fields: [presentation_id], references: [id], onDelete: Cascade)

  @@unique([presentation_id, slide_number])
  @@map("slides")
}

//////////////////////
// ASSESSMENTS
//////////////////////

model ManualScore {
  id         String   @id @default(uuid())
  org_id     String
  class_id   String
  student_id String
  term_id    String
  category   String
  score      Float
  updated_at DateTime @updatedAt

  @@unique([org_id, class_id, student_id, term_id, category])
}

model Assessment {
  id             String      @id @default(uuid())
  org_id         String
  class_id       String
  lesson_id      String?
  term_id        String
  type           String
  title          String?
  total_items    Int
  release_date   DateTime?
  end_date       DateTime?
  is_published   Boolean     @default(false)
  week_number    Int?
  created_at     DateTime    @default(now())
  deleted_at     DateTime?

  // Phase 1: Hybrid grading additions
  grading_mode     GradingMode @default(system)
  manual_max_score Float?
  show_breakdown   Boolean     @default(false)

  submissions Submission[]
}

model Question {
  id             String   @id @default(uuid())
  org_id         String
  assessment_id  String
  type           String
  question_text  String
  correct_answer String?
  choices        Json?
  order          Int      @default(0)

  // Phase 1: Hybrid grading additions
  is_manual    Boolean @default(false)
  section_type String?
}

model Submission {
  id             String           @id @default(uuid())
  org_id         String
  assessment_id  String
  student_id     String
  status         SubmissionStatus
  score          Float?
  manual_score   Float?
  submitted_at   DateTime?
  reopened_until DateTime?

  // Phase 1: Hybrid grading additions
  manual_section_score Float?
  system_section_score Float?
  is_missed            Boolean @default(false)
  is_exempted          Boolean @default(false)

  assessment Assessment @relation(fields: [assessment_id], references: [id])
}

model SubmissionAnswer {
  id            String   @id @default(uuid())
  org_id        String
  submission_id String
  question_id   String
  answer        String
  is_correct    Boolean?
}

//////////////////////
// GRADING
//////////////////////

model Grade {
  id          String    @id @default(uuid())
  org_id      String
  student_id  String
  class_id    String
  term_id     String
  final_score Float
  final_grade String
  is_locked   Boolean   @default(false)
  locked_at   DateTime?

  class Class @relation(fields: [class_id], references: [id])

  @@unique([org_id, student_id, class_id, term_id])
}

model GradeLock {
  id         String    @id @default(uuid())
  org_id     String
  class_id   String    @unique
  setting_id String
  is_locked  Boolean   @default(false)
  locked_at  DateTime?
  locked_by  String?
  created_at DateTime  @default(now())

  class   Class            @relation(fields: [class_id], references: [id])
  setting GradeLockSetting @relation(fields: [setting_id], references: [id])
}

model GradeLockEvent {
  id         String   @id @default(uuid())
  org_id     String
  class_id   String
  type       String
  reason     String?
  actor_id   String
  metadata   Json?
  created_at DateTime @default(now())

  class Class @relation(fields: [class_id], references: [id])
}

model GradeLockSetting {
  id            String    @id @default(uuid())
  org_id        String
  name          String    @default("Default Setting")
  description   String?
  lockType      String?
  lock_deadline DateTime?
  deadlineDays  Int?
  allowOverride Boolean   @default(false)
  is_default    Boolean   @default(false)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  gradeLocks GradeLock[]

  @@unique([org_id, name])
}

//////////////////////
// ATTENDANCE
//////////////////////

model AttendanceSession {
  id          String   @id @default(uuid())
  org_id      String
  class_id    String
  date        DateTime
  week_number Int
  sub_index   Int
}

model AttendanceRecord {
  id         String           @id @default(uuid())
  org_id     String
  session_id String
  student_id String
  status     AttendanceStatus
}

//////////////////////
// MEETINGS
//////////////////////

model Meeting {
  id          String    @id @default(uuid())
  org_id      String
  class_id    String
  educator_id String
  title       String
  description String?
  start_time  DateTime
  status      String    @default("scheduled")
  created_at  DateTime  @default(now())
  deleted_at  DateTime?

  class         Class                @relation(fields: [class_id], references: [id])
  invites       MeetingInvite[]
  join_requests MeetingJoinRequest[]
}

model MeetingInvite {
  id         String @id @default(uuid())
  org_id     String
  meeting_id String
  student_id String

  meeting Meeting @relation(fields: [meeting_id], references: [id])

  @@unique([meeting_id, student_id])
}

model MeetingJoinRequest {
  id         String   @id @default(uuid())
  org_id     String
  meeting_id String
  student_id String
  status     String   @default("pending")
  created_at DateTime @default(now())

  meeting Meeting @relation(fields: [meeting_id], references: [id])

  @@unique([meeting_id, student_id])
}

//////////////////////
// SYSTEM
//////////////////////

model Notification {
  id          String    @id @default(uuid())
  org_id      String
  account_id  String
  type        String
  payload     Json
  read_at     DateTime?
  archived_at DateTime?
  created_at  DateTime  @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  org_id      String
  actor_id    String
  log_type    String   @default("admin")
  action      String
  entity_type String
  entity_id   String
  metadata    Json?
  created_at  DateTime @default(now())
}

model MeetingChatMessage {
  id          String   @id @default(uuid())
  org_id      String
  meeting_id  String
  sender_id   String
  sender_name String
  message     String
  created_at  DateTime @default(now())
}
model Otp {
  id                   String    @id @default(uuid())
  email                String
  full_name            String?
  code                 String
  plan                 String?
  institution_name     String?
  role                 String?
  student_count        String?
  programs_departments String?
  expires_at           DateTime
  used_at              DateTime?
  created_at           DateTime  @default(now())
}

enum RegistrationStatus {
  pending
  approved
  rejected
}

model RegistrationRequest {
  id                   String             @id @default(uuid())
  email                String
  full_name            String
  plan                 String?
  institution_name     String?
  role                 String?
  student_count        String?
  programs_departments String?
  status               RegistrationStatus @default(pending)
  created_at           DateTime           @default(now())
  updated_at           DateTime           @updatedAt
}
